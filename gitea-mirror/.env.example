COMPOSE_PROJECT_NAME=gitea-mirror
TZ=Asia/Ho_Chi_Minh

POSTGRES_DB=gitea-mirror
POSTGRES_USER=gitea-mirror
POSTGRES_PASSWORD=gitea-mirror

USER_UID=1000
USER_GID=1000
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=8022
GITEA_ROOT_URL=http://localhost:3000/
GITEA_SSH_DOMAIN=localhost

GITEA_MIRROR_PORT=4321
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321
