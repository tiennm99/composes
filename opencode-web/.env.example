# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Web UI and API login password. MUST NOT be blank -- opencode serves the web
# interface, and with it a shell on this container, to anyone when
# OPENCODE_SERVER_PASSWORD is unset.
# Generate one with: openssl rand -base64 24
OPENCODE_SERVER_PASSWORD=

# Username to pair with it. opencode defaults to `opencode` when unset.
OPENCODE_SERVER_USERNAME=opencode

# Git identity for the commits the agent makes, as author and committer. git
# reads these directly, so no `git config` step is needed.
GIT_NAME=
GIT_EMAIL=
