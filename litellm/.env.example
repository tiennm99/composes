# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Admin key for the proxy API and the virtual keys it issues. Must start with sk-.
# Generate one with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Admin UI login.
UI_USERNAME=admin
UI_PASSWORD=

# PostgreSQL credentials, used by the database and by LiteLLM's DATABASE_URL.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm

# OpenRouter backs openrouter-free, the target of every model_group_alias in
# config.yaml. Gemini backs gemini-embedding-001 and the Gemini chat models.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Keep models added in the admin UI in PostgreSQL.
STORE_MODEL_IN_DB=True

LITELLM_MODE=PRODUCTION
LITELLM_LOG=ERROR

# Provider keys for the other models in config.yaml. Uncomment here and in
# compose.yml to enable a provider; an unset key disables only its models.
# TOKENROUTER_API_KEY=
# ORCAROUTER_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# KILO_API_KEY=
# OPENCODE_API_KEY=
# NVIDIA_NIM_API_KEY=
# OLLAMA_API_KEY=
# Cloudflare Workers AI, for the commented-out Cloudflare model in config.yaml.
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
