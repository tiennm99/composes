# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Password for the daemon API and web UI.
# Generate one with: openssl rand -base64 24
PASEO_PASSWORD=

# Comma-separated DNS names allowed to reach the daemon. The domain mapped in
# Coolify/Dokploy must be listed here. IPs and localhost are always allowed.
PASEO_HOSTNAMES=
