# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Bearer token for the gateway API and dashboard. Required.
# Generate one with: openssl rand -hex 16
GOCLAW_GATEWAY_TOKEN=

# AES-256-GCM key encrypting the LLM provider keys stored in PostgreSQL.
# Generate one with: openssl rand -hex 32
GOCLAW_ENCRYPTION_KEY=

# PostgreSQL credentials. Used by the database and by the DSN GoClaw connects
# with, so both sides move together.
POSTGRES_USER=goclaw
POSTGRES_PASSWORD=goclaw
POSTGRES_DB=goclaw

# Apply schema migrations and data hooks on startup.
GOCLAW_AUTO_UPGRADE=true

# MiniMax keys, for the MiniMax LLM provider and text-to-speech. Uncomment
# here and in compose.yml to use MiniMax.
# GOCLAW_MINIMAX_API_KEY=
# GOCLAW_TTS_MINIMAX_API_KEY=
# GOCLAW_TTS_MINIMAX_GROUP_ID=

# Set to 1 to log full LLM request and response bodies.
# GOCLAW_TRACE_VERBOSE=0
