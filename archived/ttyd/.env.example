# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Web login password. Required.
# Generate one with: openssl rand -base64 24
PASSWORD=

# Container hostname, also passed in as HOST -- the name zsh's prompt shows.
SERVICE_HOSTNAME=ttyd

# Git identity baked into the container (author + committer).
GIT_NAME=
GIT_EMAIL=
