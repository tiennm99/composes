# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Public hostname, without scheme. Also the only trusted domain.
OWNCLOUD_DOMAIN=owncloud.example.com

# Admin account, created on first start only.
# Generate a password with: openssl rand -base64 24
OWNCLOUD_ADMIN_USERNAME=admin
OWNCLOUD_ADMIN_PASSWORD=

# MariaDB credentials, used by the database and by ownCloud.
DB_NAME=owncloud
DB_USER=owncloud
DB_PASSWORD=
DB_ROOT_PASSWORD=
