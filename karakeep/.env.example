# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Signs login sessions. Keep it stable.
# Generate one with: openssl rand -base64 36
NEXTAUTH_SECRET=
# The public URL Karakeep is served at.
NEXTAUTH_URL=https://karakeep.example.com

# Shared by Karakeep and Meilisearch.
# Generate one with: openssl rand -base64 36
MEILI_MASTER_KEY=

# Set to true after the first account is created.
DISABLE_SIGNUPS=false

# OpenAI-compatible provider for AI tagging. Empty key: no AI tagging.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
INFERENCE_TEXT_MODEL=gpt-6-luna
INFERENCE_IMAGE_MODEL=gpt-4o-mini
INFERENCE_MAX_OUTPUT_TOKENS=2048
INFERENCE_JOB_TIMEOUT_SEC=30
# Embeddings for semantic search and tag suggestions.
EMBEDDING_ENABLE_AUTO_INDEXING=false
EMBEDDING_TEXT_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_CONTEXT_LENGTH=8000
# Extra Node.js flags, such as a larger heap: --max-old-space-size=4096
NODE_OPTIONS=

# INFERENCE_LANG=english
# INFERENCE_ENABLE_AUTO_SUMMARIZATION=false
# CRAWLER_FULL_PAGE_ARCHIVE=false
# MAX_ASSET_SIZE_MB=50
