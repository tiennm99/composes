# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Engine CLIs installed into the image, as space-separated npm packages.
ENGINES=@anthropic-ai/claude-code @openai/codex

# Full public URL, scheme included, no trailing slash. Pairing links and
# webhook URLs point here.
OMB_PUBLIC_URL=https://openmausbot.example.com

# Who may sign in with an emailed code at /pair: addresses or @domain entries,
# comma-separated. Admins get full access, members chat and approvals only.
# OMB_SIGNIN_EMAILS=
# OMB_SIGNIN_MEMBER_EMAILS=
# Send those codes through your own mail server, e.g.
# smtps://user%40example.com:PASSWORD@smtp.example.com:465
# OMB_SIGNIN_SMTP_URL=
# OMB_SIGNIN_SMTP_FROM=

# Name the apps show for this server.
# OMB_SERVER_NAME=openmausbot
