# Takes the client address from Cloudflare or the platform proxy.
{
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	# Webhook ingress, served without a login.
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The app, with server-sent events streamed as they arrive.
	handle {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}
}
