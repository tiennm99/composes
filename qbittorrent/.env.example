# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Login for the web UI, set on every start.
# Generate a password with: openssl rand -base64 24
WEBUI_USERNAME=qbittorrent
WEBUI_PASSWORD=

# Peer port for incoming connections, TCP and UDP. Open it in the host's
# firewall.
TORRENTING_PORT=6881

TZ=Asia/Ho_Chi_Minh
