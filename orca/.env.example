# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Address clients dial: the node's MagicDNS name on the tailnet, as a wss://
# URL. Required.
ORCA_PAIRING_ADDRESS=wss://orca.tailnet-name.ts.net

# Which pairing link the server prints in its log on start: runtime (browser
# and desktop clients), mobile (the Orca mobile app) or none.
ORCA_PAIRING=runtime

# Container hostname, also passed in as HOST -- the name zsh's prompt shows.
SERVICE_HOSTNAME=orca

# Git identity for agents and terminals, as author and committer.
GIT_NAME=
GIT_EMAIL=

# Tailscale auth key for the node's first login. Required.
TS_AUTHKEY=

# Machine name on the tailnet, the first label of its MagicDNS name.
TS_HOSTNAME=orca
