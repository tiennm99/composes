# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Public address clients dial: the domain mapped in Coolify/Dokploy, as a
# wss:// URL. Required.
ORCA_PAIRING_ADDRESS=wss://orca.example.com

# Which pairing link the server prints in its log on start: runtime (browser
# and desktop clients), mobile (the Orca mobile app) or none.
ORCA_PAIRING=runtime

# Container hostname, also passed in as HOST -- the name zsh's prompt shows.
SERVICE_HOSTNAME=orca

# Git identity for agents and terminals, as author and committer.
GIT_NAME=
GIT_EMAIL=
