# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Web UI login password. MUST NOT be blank -- the LinuxServer image serves
# code-server without authentication when PASSWORD is empty.
# Also used for SUDO_PASSWORD inside the container.
# Generate one with: openssl rand -base64 24
PASSWORD=

# Git identity baked into the container (author + committer).
GIT_NAME=
GIT_EMAIL=
